POSTGRES_USER=stash
# 반드시 아래 명령으로 생성한 값으로 교체할 것 (기본값으로 두면 프로덕션에서 기동이 중단됨)
#   openssl rand -hex 16
POSTGRES_PASSWORD=
POSTGRES_DB=stash
POSTGRES_PORT=5433
DATABASE_URL=postgresql://stash:YOUR_POSTGRES_PASSWORD@localhost:5433/stash

# 반드시 아래 명령으로 생성한 값으로 교체할 것 (기본값으로 두면 프로덕션에서 기동이 중단됨)
#   openssl rand -hex 32
JWT_SECRET=

# 아이템 상세페이지 딥링크(내부 발급 QR 라벨)에 사용하는 공개 URL. 프로덕션에서는
# 실제 접속 도메인으로 바꿔야 QR을 아무 카메라 앱으로 스캔해도 바로 열린다.
APP_PUBLIC_URL=http://localhost

# 최초 관리자 계정 (npm run seed -w apps/api 실행 시 사용)
# 시드/개발용 — 프로덕션에서는 강한 비밀번호로 바꿀 것
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# --- 아래는 선택 사항. 없어도 자체 발급 바코드/수동 입력만으로 전체 기능이 동작한다 ---

# UPCItemDB(https://www.upcitemdb.com) 조회 API 키. 없으면 Open Food Facts만 조회한다.
UPCITEMDB_API_KEY=

# 재고 이벤트 웹훅을 받을 URL (선택). 설정하면 아이템 생성/수정/수량조정/스캔 시 알림이 전송된다.
INVENTORY_WEBHOOK_URL=

# HTTPS 배포에서 미디어 쿠키에 Secure 플래그를 켜려면 true (compose가 api 컨테이너에 전달함)
# COOKIE_SECURE=true

# 로컬 `npm run dev`(web:3000 → api:8080 교차 오리진)에서만 주석을 해제하세요.
# sameSite=lax 쿠키가 <img>에 실리지 않아 사진이 안 뜨므로 첨부 인증을 끕니다.
# 프로덕션/compose(Caddy same-origin)에서는 절대 켜지 말 것.
# 기본값을 true로 두면 나중에 compose에 env_file: .env 를 붙이는 순간 프로덕션 인증이 꺼집니다.
# MEDIA_AUTH_DISABLED=true
